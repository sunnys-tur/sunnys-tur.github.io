---
import { Image } from 'astro:assets';
import comet from '../assets/images/about/comet.png';
import { getDict, defaultLang, type Lang } from '../i18n';

interface Props {
  lang?: Lang;
  heading?: string;
  body?: string[];
  imageAlt?: string;
}

const t = getDict(Astro.props.lang ?? defaultLang);
const { heading = t.about.heading, body = t.about.body, imageAlt = t.about.imageAlt } = Astro.props;
---

<section id="about" class="py-section">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-14">
    <div class="flex justify-center">
      <Image src={comet} alt={imageAlt} width={600} loading="lazy" class="h-auto w-full max-w-lg drop-shadow-xl" />
    </div>

    <div class="space-y-5">
      <h2 class="font-heading text-h2 font-bold uppercase text-text">{heading}</h2>
      {body.map((paragraph) => (
        <p class="text-lead leading-relaxed text-text-muted">{paragraph}</p>
      ))}
    </div>
  </div>
</section>
