---
import { getDict, defaultLang, languages, type Lang } from '../i18n';
import { brand } from "../config/brand";
import { siteData } from "../data/siteData";

const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = getDict(lang);
const { nav } = siteData;
const strip = (p: string) =>
  p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p;
const currentPath = strip(Astro.url.pathname);
---

<header
  class="sticky top-0 z-50 w-full border-b border-border bg-background/95 backdrop-blur-sm"
  transition:persist
>
  <div
    class="mx-auto flex max-w-site items-center justify-between px-4 py-4 sm:px-6"
  >
    <!-- Logo -->
    <div class="flex flex-col gap-2">
    <a
      href="/"
      class="inline-flex items-center gap-2 font-heading text-xl font-bold uppercase tracking-wide text-primary transition-opacity hover:opacity-80"
    >
      <img src="/images/logo-sun.png" alt={brand.name} width="96" height="96" class="size-20 rounded-full bg-[#0a8fd8] object-contain shadow-md sm:size-24" />
    </a>
      <span class="rounded-full lg:hidden text-xs font-medium">
        {siteData.license}
      </span>
      </div>

    <!-- Desktop nav -->
    <nav
      class="hidden items-center gap-1 lg:flex"
      aria-label="Primary navigation"
    >
      {
        nav.map(({ label, href }) => {
          const isActive =
            currentPath === href ||
            (href !== "/" && currentPath.startsWith(href));
          return (
            <a
              href={href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "rounded-md px-3 py-2 text-sm font-medium transition-colors",
                isActive
                  ? "bg-primary/10 text-primary"
                  : "text-text-muted hover:text-text",
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <!-- Desktop CTA + phone -->
    <div class="hidden items-center gap-4 lg:flex">
      {
        siteData.license && (
          <span class="rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-text-muted">
            {siteData.license}
          </span>
        )
      }
      <a
        href={`tel:${siteData.phoneForTel}`}
        class="text-sm font-semibold text-text transition-colors hover:text-primary"
      >
        {siteData.phoneFormatted}
      </a>
      <a
        href={siteData.whatsapp}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex min-h-11 items-center rounded-md bg-green-600 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent"
      >
        {t.whatsapp}
      </a>
    </div>

    <div class="ml-auto mr-2 flex items-center gap-1 lg:ml-0 lg:mr-0">
    <!-- Language switcher -->
    <nav aria-label={t.language} class="flex items-center gap-0.5">
      {(Object.entries(languages) as [Lang, (typeof languages)[Lang]][]).map(([code, l]) => (
        <a
          href={l.path}
          hreflang={code}
          data-astro-reload
          lang={code}
          title={l.label}
          aria-current={code === lang ? "true" : undefined}
          class:list={[
            "rounded-md px-2 py-2 text-xs font-bold transition-colors",
            code === lang ? "bg-primary/10 text-primary" : "text-text-muted hover:text-text",
          ]}
        >
          {l.short}
        </a>
      ))}
    </nav>

    <!-- Theme toggle -->
    <button
      id="theme-toggle"
      type="button"
      aria-label={t.toggleTheme}
      class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-text-muted hover:bg-surface hover:text-text lg:ml-0 lg:mr-0"
    >
      <svg class="theme-icon-sun hidden size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="theme-icon-moon size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
    </button>
    </div>

    <!-- Mobile menu button — CSS-only hamburger/X animation -->
    <button
      id="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="relative inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-text-muted hover:bg-surface lg:hidden"
    >
      <span class="sr-only">{t.toggleMenu}</span>
      <span class="hamburger-box" aria-hidden="true">
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
        <span class="hamburger-bar"></span>
      </span>
    </button>
  </div>

  <!-- Mobile drawer -->
  <div
    id="mobile-menu"
    class="mobile-drawer"
    inert
  >
    <div class="border-t border-border bg-background">
      <nav class="flex flex-col gap-1" aria-label="Mobile navigation">
        {
          nav.map(({ label, href }) => {
            const isActive =
              currentPath === href ||
              (href !== "/" && currentPath.startsWith(href));
            return (
              <a
                href={href}
                class:list={[
                  "rounded-md px-3 py-3 text-base font-medium transition-colors",
                  isActive
                    ? "bg-primary/10 text-primary"
                    : "text-text-muted hover:text-text hover:bg-surface",
                ]}
              >
                {label}
              </a>
            );
          })
        }
      </nav>

      <div class="mt-4 flex flex-col gap-3 border-t border-border pt-4 pb-6">
        <a
          href={`tel:${siteData.phoneForTel}`}
          class="flex items-center gap-2 px-3 py-2 text-base font-semibold text-text"
        >
          {siteData.phoneFormatted}
        </a>
        <a
          href={siteData.whatsapp}
          target="_blank"
          rel="noopener noreferrer"
          class="flex min-h-11 items-center justify-center rounded-md bg-green-600 px-5 py-3 mx-3 text-base font-bold text-white shadow-sm transition-opacity hover:opacity-90"
        >
          {t.whatsapp}
        </a>

      </div>
    </div>
  </div>
</header>

<style is:global>
  html.dark-mode .theme-icon-sun { display: block; }
  html.dark-mode .theme-icon-moon { display: none; }
</style>

<style>
  /* ── Hamburger bars ─────────────────────────────────────────────────────── */
  .hamburger-box {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
    height: 22px;
  }
  .hamburger-bar {
    display: block;
    width: 100%;
    height: 2px;
    border-radius: 9999px;
    background-color: currentColor;
    transition:
      transform 0.3s ease,
      opacity 0.3s ease;
    transform-origin: center;
  }

  /* Open state — morph to X */
  [aria-expanded="true"] .hamburger-bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }
  [aria-expanded="true"] .hamburger-bar:nth-child(2) {
    opacity: 0;
  }
  [aria-expanded="true"] .hamburger-bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  /* ── Mobile drawer slide-down ───────────────────────────────────────────── */
  .mobile-drawer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }
  .mobile-drawer.is-open {
    grid-template-rows: 1fr;
  }
  .mobile-drawer > div {
    min-height: 0;
    overflow: hidden;
  }

  /* Scoped display:grid overrides Tailwind's lg:hidden (layer conflict),
     so we handle the desktop breakpoint here directly. */
  @media (min-width: 1024px) {
    .mobile-drawer {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hamburger-bar,
    .mobile-drawer {
      transition-duration: 0.01ms !important;
    }
  }
</style>

<script>
  function initHeader() {
    const header = document.querySelector("header") as HTMLElement;
    const btn = document.getElementById("menu-toggle") as HTMLButtonElement;
    const menu = document.getElementById("mobile-menu") as HTMLElement;
    if (!header || !btn || !menu) return;

    // Prevent duplicate listeners when transition:persist keeps the DOM
    if (header.dataset.headerInit === "true") return;
    header.dataset.headerInit = "true";

    const ACTIVE = ["bg-primary/10", "text-primary"];
    const INACTIVE_DT = ["text-text-muted", "hover:text-text"];
    const INACTIVE_MB = ["text-text-muted", "hover:text-text", "hover:bg-surface"];
    const isDesktop = () => window.matchMedia("(min-width: 1024px)").matches;
    const strip = (p: string) => (p.length > 1 && p.endsWith("/") ? p.slice(0, -1) : p);

    let focusableEls: HTMLElement[] = [];

    function getFocusable(): HTMLElement[] {
      return Array.from(
        menu.querySelectorAll<HTMLElement>(
          'a[href], button, input, textarea, select, [tabindex]:not([tabindex="-1"])'
        )
      );
    }

    function trapFocus(e: KeyboardEvent) {
      if (e.key !== "Tab") return;
      const els = focusableEls;
      if (els.length === 0) return;
      const first = els[0];
      const last = els[els.length - 1];
      if (e.shiftKey) {
        if (document.activeElement === first || document.activeElement === btn) {
          e.preventDefault();
          last.focus();
        }
      } else if (document.activeElement === last) {
        e.preventDefault();
        btn.focus();
      }
    }

    function setMenuOpen(open: boolean) {
      if (isDesktop()) open = false;
      btn.setAttribute("aria-expanded", String(open));
      menu.toggleAttribute("inert", !open);
      menu.classList.toggle("is-open", open);
      document.body.classList.toggle("overflow-hidden", open);

      if (open) {
        focusableEls = getFocusable();
        document.addEventListener("keydown", trapFocus);
      } else {
        document.removeEventListener("keydown", trapFocus);
      }
    }

    function syncActiveLinks() {
      const path = strip(window.location.pathname);
      const dtLinks = header.querySelectorAll('nav[aria-label="Primary navigation"] a');
      const mbLinks = header.querySelectorAll("#mobile-menu nav a");

      dtLinks.forEach((link) => {
        const href = strip(link.getAttribute("href") || "");
        const active = href === path || (href !== "/" && path.startsWith(href));
        link.classList.toggle(ACTIVE[0], active);
        link.classList.toggle(ACTIVE[1], active);
        link.classList.toggle(INACTIVE_DT[0], !active);
        link.classList.toggle(INACTIVE_DT[1], !active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });

      mbLinks.forEach((link) => {
        const href = strip(link.getAttribute("href") || "");
        const active = href === path || (href !== "/" && path.startsWith(href));
        link.classList.toggle(ACTIVE[0], active);
        link.classList.toggle(ACTIVE[1], active);
        link.classList.toggle(INACTIVE_MB[0], !active);
        link.classList.toggle(INACTIVE_MB[1], !active);
        link.classList.toggle(INACTIVE_MB[2], !active);
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
    }

    // ── Event listeners (bound once) ──────────────────────────────

    // Toggle menu
    btn.addEventListener("click", () => {
      if (isDesktop()) return;
      setMenuOpen(btn.getAttribute("aria-expanded") !== "true");
    });

    // Close on link click inside drawer
    menu.addEventListener("click", (e) => {
      if ((e.target as Element).closest?.("a[href]")) setMenuOpen(false);
    });

    // Escape closes drawer
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
        btn.focus();
      }
    });

    // Resize to desktop closes drawer
    window.addEventListener("resize", () => {
      if (isDesktop() && btn.getAttribute("aria-expanded") === "true") {
        setMenuOpen(false);
      }
    });

    // ── View Transitions: reset menu & sync active links ──────────
    // Registered once — persists across navigations because the
    // header DOM (and therefore this closure) survives transition:persist.
    document.addEventListener("astro:after-swap", () => {
      setMenuOpen(false);
      syncActiveLinks();
    });

    // Initial state
    setMenuOpen(false);
    syncActiveLinks();
  }

  // astro:page-load fires on first load AND after each transition.
  // The init guard above ensures listeners only bind once.
  document.addEventListener("astro:page-load", initHeader);
</script>

<script>
  const root = document.documentElement;
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = root.classList.toggle("dark-mode");
    localStorage.setItem("theme", dark ? "dark" : "light");
  });
</script>
