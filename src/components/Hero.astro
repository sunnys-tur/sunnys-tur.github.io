---
import { getDict, defaultLang, type Lang } from '../i18n';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';
import { heroImage as localHeroImage } from '../config/images';

const PLACEHOLDER = 'https://images.unsplash.com/photo-1504307651254-35680f356dfd?w=1200&q=80';

interface Props {
  lang?: Lang;
  topper?: string;
  heading?: string;
  description?: string;
  ctaLabel?: string;
  ctaHref?: string;
  secondaryLabel?: string;
  imageSrc?: ImageMetadata | string;
  imageAlt?: string;
}

const _p = Astro.props;
const t = getDict(_p.lang ?? defaultLang);
const {
  topper = t.hero.topper,
  heading = t.hero.title,
  description = t.hero.languages,
  ctaLabel = t.hero.cta,
  ctaHref = siteData.whatsapp,
  secondaryLabel = t.hero.secondary,
  imageSrc = localHeroImage ?? PLACEHOLDER,
  imageAlt = t.hero.imageAlt,
} = Astro.props;
---

<section class="relative overflow-hidden bg-background py-12 sm:py-16 md:py-20 lg:py-24">
  <div class="mx-auto grid max-w-site grid-cols-1 items-center gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:gap-12">

    <!-- Copy -->
    <div class="order-2 space-y-5 lg:order-1 lg:space-y-6">
      {topper && (
        <span class="inline-block rounded-full bg-primary/10 px-4 py-1.5 text-topper font-bold uppercase tracking-widest text-primary">
          {topper}
        </span>
      )}

      <h1
        class="font-heading text-h1 font-bold uppercase leading-tight tracking-tight text-text"
        transition:name="hero-heading"
      >
        {heading}
      </h1>

      <p class="max-w-lg text-lead text-text-muted leading-relaxed">
        {description}
      </p>

      <!-- CTA row -->
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:items-center sm:gap-4">
        <a
          href={ctaHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center justify-center gap-2 rounded-md bg-green-600 px-6 py-3 text-base font-bold text-white shadow-sm transition-opacity hover:opacity-90 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-green-600"
        >
          <svg class="size-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.61-.92-2.2-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zM12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91C21.95 6.45 17.5 2 12.04 2z"/></svg>
          {ctaLabel}
        </a>
        <a
          href="#vehicles"
          class="inline-flex min-h-11 items-center justify-center rounded-md border-2 border-primary px-6 py-3 text-base font-bold text-primary transition-colors hover:bg-primary hover:text-primary-fg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
        >
          {secondaryLabel}
        </a>
      </div>

      <!-- Tap-to-call -->
      <a
        href={`tel:${siteData.phoneForTel}`}
        class="inline-flex items-center gap-2 pt-1 text-sm font-semibold text-text-muted transition-colors hover:text-primary"
      >
        {t.call}{" "}{siteData.phoneFormatted}
      </a>
    </div>

    <!-- Hero image -->
    <div
      class="relative order-1 overflow-hidden rounded-lg shadow-xl aspect-4/3 lg:order-2"
      transition:name="hero-image"
    >
      <Image
        src={imageSrc}
        alt={imageAlt}
        width={800}
        height={600}
        loading="eager"
        decoding="async"
        class="size-full object-cover"
      />
    </div>
  </div>
</section>
