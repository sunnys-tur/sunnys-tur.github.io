---
import { getDict, defaultLang, type Lang } from '../i18n';
import { brand } from '../config/brand';
import { siteData } from '../data/siteData';

const { lang = defaultLang } = Astro.props as { lang?: Lang };
const t = getDict(lang);
const year = new Date().getFullYear();
const link = 'text-slate-300 transition-colors hover:text-white';
const instagramHandle = siteData.socials.instagram.replace(/\/$/, '').split('/').pop();
---

<footer class="bg-[#0b1220] text-slate-300" transition:persist>
  <div class="mx-auto max-w-site px-4 py-12 sm:px-6 lg:py-16">
    <div class="grid grid-cols-1 gap-10 sm:grid-cols-2">

      <!-- Brand -->
      <div>
        <a href="/" class="font-heading text-xl font-bold uppercase tracking-wide text-white">
          {brand.name}
        </a>
        <p class="mt-1 text-xs font-medium text-slate-400">{siteData.license}</p>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-slate-300">{t.tagline}</p>

        {siteData.socials.instagram && (
          <a
            href={siteData.socials.instagram}
            target="_blank"
            rel="noopener noreferrer"
            class:list={['mt-5 inline-flex items-center gap-2 text-sm font-semibold', link]}
          >
            <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
            Instagram @{instagramHandle}
          </a>
        )}
      </div>

      <!-- Contact info -->
      <div>
        <h3 class="text-sm font-bold uppercase tracking-wider text-white">{t.footer.contact}</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li>
            <a href={siteData.whatsapp} target="_blank" rel="noopener noreferrer" class={link}>
              WhatsApp: {siteData.phoneFormatted}
            </a>
          </li>
          <li>
            <a href={`tel:${siteData.landlineForTel}`} class={link}>
              {t.footer.phone}: {siteData.landlineFormatted}
            </a>
          </li>
          <li>
            <a href={`mailto:${siteData.email}`} class={link}>{t.footer.email}: {siteData.email}</a>
          </li>
          <li>
            <a href={`mailto:${siteData.driverEmail}`} class={link}>{t.footer.driverEmail}: {siteData.driverEmail}</a>
          </li>
          <li>
            <a href={siteData.address.mapLink} target="_blank" rel="noopener noreferrer" class={link}>
              {t.footer.location}
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-10 border-t border-white/10 pt-6 text-center text-sm text-slate-400">
      &copy; {year}{" "}{brand.name}. {t.footer.rights}
      <p class="mt-2">
        {t.footer.createdBy}{" "}
        <a href="https://github.com/F4NT0" target="_blank" rel="noopener noreferrer" class="font-semibold text-slate-200 underline-offset-2 transition-colors hover:text-white hover:underline">Gabriel Fanto Stundner</a>
      </p>
    </div>
  </div>
</footer>
